# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- General / macOS ---
.DS_Store
*.pem
*.log

# --- Dependencies ---
/node_modules

# --- AI agents files ---
.claude/*
!.claude/settings.json
.mind.*
mind.*
plans/**/*

# --- Debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Env files (can opt-in for committing if needed) ---
.env*
!.env.example

# --- IDE ---
.idea/

# --- MoMorph / MCP ---
.mcp.json
mcp.json

# --- Web (Next.js / Node.js) ---
/.next/
/out/
/build
/dist
.vercel
*.tsbuildinfo
next-env.d.ts
/.open-next
.wrangler
.dev.vars*
!.dev.vars.example
yarn.lock
package-lock.json

# --- Android ---
.gradle/
**/build/
local.properties
*.apk
*.aab
*.jks
*.keystore

# --- iOS / Xcode ---
build/
Pods/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip
*.hmap
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xcuserdata
*.xcworkspace/xcuserdata/
